# --- macOS / OS cruft ---
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db

# --- Editors / IDEs ---
.idea
.vscode/
*.swp
*.swo
*~

# --- Agent / local tool config (commit shared .claude/settings.json; ignore local + caches) ---
.aider*
.claude/settings.local.json
.cache
.pki

# --- Secrets / environment ---
.env
.env.*
!.env.sample
.envrc

# --- Node (diagram renderers: @mermaid-js/mermaid-cli, vega-cli) ---
node_modules/
npm-debug.log*
.npm/

# --- Logs / scratch ---
*.log
*.tmp
tmp/

# NOTE: rendered diagrams (_spec/**/*.svg) are intentionally committed — the SPEC
# convention version-controls them next to their source. Do not ignore *.svg.
